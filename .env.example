# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
# Local: mongodb://localhost:27017/feedants_competition
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/feedants_competition?retryWrites=true&w=majority
MONGODB_URI=MONGO_URL

# JWT
JWT_SECRET= JWT_SECRET
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*
